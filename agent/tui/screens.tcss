/* Modal-screen styles for the TUI, loaded via each screen's CSS_PATH.
   Kept separate from app.tcss (the app chrome) so screens own their layout. */

/* ---- LeaderboardScreen ---- */
LeaderboardScreen { align: center middle; }
#board-title { height: 1; background: $panel; padding: 0 1; }
#board-table {
    width: 90; height: 80%;
    background: $panel; border: round $primary; padding: 0 1;
}

/* ---- ProofDiffScreen ---- */
ProofDiffScreen { width: 100%; height: 100%; }
#diff-title { height: 1; background: $panel; padding: 0 1; }
#diff-body { height: 1fr; padding: 0 1; }

/* ---- MessageScreen ---- */
MessageScreen { align: center middle; }
#command-output {
    width: 76; max-width: 90; height: auto; max-height: 70%;
    background: $panel; border: round $primary; padding: 1 2;
}
#command-output-body { height: auto; }
#command-output-buttons { dock: bottom; height: auto; align-horizontal: right; margin-top: 1; }
#command-output-buttons Button { margin-left: 2; }

/* ---- ProveScreen ---- */
ProveScreen { align: center middle; }
#prove-box {
    width: 90; height: 80%;
    background: $panel; border: round $primary; padding: 1 2;
}
#prove-input { height: 1fr; margin-bottom: 1; scrollbar-size: 1 1; }
#prove-buttons { height: auto; dock: bottom; align-horizontal: right; }
#prove-buttons Button { margin-left: 2; }

/* ---- WorkersScreen ---- */
WorkersScreen { align: center middle; }
#workers-box {
    width: 60; height: 7;
    background: $panel; border: round $primary; padding: 1 2;
}

/* ---- ReplayScreen ---- */
ReplayScreen { width: 100%; height: 100%; }
#replay-title { height: 1; background: $panel; padding: 0 1; }
#replay-side { width: 1fr; }
#replay-buttons { dock: bottom; height: auto; align-horizontal: right; margin-top: 1; }
#replay-buttons Button { margin-left: 2; }

/* ---- SessionRenameScreen ---- */
SessionRenameScreen { align: center middle; }
#rename-box {
    width: 72; height: 7;
    background: $panel; border: round $primary; padding: 1 2;
}

/* ---- SessionsScreen ---- */
SessionsScreen { align: center middle; }
#sess-search { width: 90; height: 3; margin-bottom: 1; }
#sess-count { width: 90; height: 1; }
#sess-list {
    width: 90; height: 80%;
    background: $panel; border: round $primary; padding: 1 2;
}

/* ---- TrustScreen ---- */
TrustScreen { align: center middle; }
#trust-box {
    width: 92; height: 80%;
    background: $panel; border: round $primary; padding: 1 2;
}

/* ---- PromptsScreen ---- */
PromptsScreen { align: center middle; }
#prompts-search { width: 90; height: 3; margin-bottom: 1; }
#prompts-list {
    width: 90; height: 80%;
    background: $panel; border: round $primary; padding: 1 2;
}

/* ---- PromptEditScreen ---- */
PromptEditScreen { align: center middle; }
#prompt-edit-box {
    width: 90; height: 80%;
    background: $panel; border: round $primary; padding: 1 2;
}
#prompt-edit-input { height: 1fr; margin-bottom: 1; scrollbar-size: 1 1; }
#prompt-edit-buttons { dock: bottom; height: auto; align-horizontal: right; }
#prompt-edit-buttons Button { margin-left: 2; }

/* ---- PromptNewScreen ---- */
PromptNewScreen { align: center middle; }
#prompt-new-box {
    width: 90; height: 80%;
    background: $panel; border: round $primary; padding: 1 2;
}
#new-name { height: 3; margin-bottom: 1; }
#new-content { height: 1fr; margin-bottom: 1; scrollbar-size: 1 1; }
#prompt-new-buttons { dock: bottom; height: auto; align-horizontal: right; }
#prompt-new-buttons Button { margin-left: 2; }

/* ---- ModelsScreen ---- */
ModelsScreen { align: center middle; }
#models-box {
    width: 92; height: 80%;
    background: $panel; border: round $primary; padding: 1 2;
}
#models-title { height: 1; }
#models-search { height: 3; margin-bottom: 1; }
#models-list { height: 1fr; }

/* ---- ModelFormScreen ---- */
ModelFormScreen { align: center middle; }
#model-form {
    width: 76; height: auto;
    background: $panel; border: round $primary; padding: 1 2;
}
#model-form Input { margin-bottom: 1; }
#model-form-buttons { dock: bottom; height: auto; align-horizontal: right; }
#model-form-buttons Button { margin-left: 2; }

/* ---- ConfirmScreen ---- */
ConfirmScreen { align: center middle; }
#confirm-box {
    width: 72; height: auto;
    background: $panel; border: round $primary; padding: 1 2;
}
#confirm-body { margin-top: 1; }
#confirm-buttons { dock: bottom; height: auto; align-horizontal: right; margin-top: 1; }
#confirm-buttons Button { margin-left: 2; }

/* ---- SettingsScreen ---- */
SettingsScreen { align: center middle; }
#settings-box {
    width: 84; height: 80%;
    background: $panel; border: round $primary; padding: 1 2;
}
#settings-title { height: 1; margin-bottom: 1; }
.setting-label { height: 1; margin-top: 1; text-style: bold; }
#settings-box Select, #settings-box Input { height: 3; }
#settings-buttons { dock: bottom; height: auto; align-horizontal: right; margin-top: 1; }
#settings-buttons Button { margin-left: 2; }
